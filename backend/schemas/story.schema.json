{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Story",
  "type": "object",
  "required": ["title", "language", "ageRange", "genre", "setting", "moral", "characters", "scenes"],
  "properties": {
    "title": { "type": "string", "minLength": 3 },
    "language": { "type": "string", "enum": ["de", "en"] },
    "ageRange": { "type": "string" },
    "genre": { "type": "string" },
    "setting": { "type": "string" },
    "moral": { "type": "string" },
    "characters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "gender", "role"],
        "properties": {
          "name": { "type": "string" },
          "gender": { "type": "string", "enum": ["male", "female", "neutral"] },
          "role": { "type": "string" }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["index", "text", "imagePrompt", "bgmMood"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 20 },
          "imagePrompt": { "type": "string" },
          "bgmMood": { "type": "string" }
        }
      }
    }
  }
}
